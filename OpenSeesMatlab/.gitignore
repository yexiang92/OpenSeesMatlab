# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
# *.prj

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag

# buildtool cache folder
.buildtool/

# SimBiology backup files
*.sbproj.backup
*.sbproj.bak

*.html

# MATLAB stores the project definition behind the small .prj entry point.
# Track that definition so a clone opens the same project, but keep generated
# build-tool state out of version control.
resources/*
!resources/project/
!resources/project/**
release/
